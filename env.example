# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8010,http://127.0.0.1:8010

# Production database (RunFlare panel — external Postgres, e.g. Liara DB host)
USE_LOCAL_DB=False
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=your-db-host.example.com
DB_PORT=5432

# Local development database (Docker: mignum-postgres on 55434)
# USE_LOCAL_DB=True
LOCAL_DB_NAME=mignum
LOCAL_DB_USER=mignum
LOCAL_DB_PASSWORD=mignum_local
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=55434

# Redis / Channels (optional — leave REDIS_HOST empty to use in-memory layer)
USE_REDIS=False
REDIS_HOST=
REDIS_PORT=6379

# Zarinpal Payment Gateway
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id
ZARINPAL_SANDBOX=True
ZARINPAL_CURRENCY_UNIT=IRT
FRONTEND_PAYMENT_RETURN_PATH=/orders

# --- RunFlare production (copy to panel from deploy/runflare.env.example) ---
# DEBUG=False
# ALLOWED_HOSTS=ovyraworld.runflare.run,ovyraword.runflare.run,ovyraworld-nd7-ovyraworld.runflare.cloud
# CORS_ALLOWED_ORIGINS=https://ovyraworld.runflare.run,https://ovyraword.runflare.run,https://ovyraworld-nd7-ovyraworld.runflare.cloud
# CSRF_TRUSTED_ORIGINS=https://ovyraworld.runflare.run,https://ovyraword.runflare.run,https://ovyraworld-nd7-ovyraworld.runflare.cloud
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
