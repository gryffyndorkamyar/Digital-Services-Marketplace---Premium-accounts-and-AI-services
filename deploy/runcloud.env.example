# Copy to RunCloud → Web Application → Environment Variables
# OVYRA domains on RunFlare:

DEBUG=False
SECRET_KEY=generate-a-long-random-secret-key-here

ALLOWED_HOSTS=ovyraworld.runflare.run,ovyraword.runflare.run,ovyraworld-nd7-ovyraworld.runflare.cloud
CORS_ALLOWED_ORIGINS=https://ovyraworld.runflare.run,https://ovyraword.runflare.run,https://ovyraworld-nd7-ovyraworld.runflare.cloud
CSRF_TRUSTED_ORIGINS=https://ovyraworld.runflare.run,https://ovyraword.runflare.run,https://ovyraworld-nd7-ovyraworld.runflare.cloud

USE_LOCAL_DB=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mignum
DB_USER=mignum_user
DB_PASSWORD=strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

USE_REDIS=False
REDIS_HOST=
REDIS_PORT=6379

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=False
ZARINPAL_CURRENCY_UNIT=IRT
FRONTEND_PAYMENT_RETURN_PATH=/orders

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Set to 1 only if Node.js is installed on the server
# BUILD_FRONTEND_ON_SERVER=0
