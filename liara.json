{
  "app": "mignum",
  "port": 8000,
  "platform": "django",
  "build": {
    "location": "iran",
    "command": "pip install -r requirements.txt && python manage.py migrate --noinput && python manage.py collectstatic --noinput"
  },
  "args": ["gunicorn", "main.wsgi:application", "-c", "gunicorn.conf.py"],
  "disks": [
    {
      "name": "data",
      "mountTo": "data"
    },
    {
      "name": "media",
      "mountTo": "/usr/src/app/media"
    }
  ]
}
